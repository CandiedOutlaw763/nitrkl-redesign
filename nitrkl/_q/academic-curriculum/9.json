{"t": "Curriculum", "b": "<h2 id=\"applied-geology-m-sc-2yrs\">Applied Geology (M.Sc. - 2yrs)</h2>\n<details class=\"cp-acc\"><summary>Programme Outcomes (POs)</summary><div class=\"cp-acc-body\">\n<div aria-label=\"Applied Geology (M.Sc. - 2yrs)\" class=\"cp-table\" role=\"region\" tabindex=\"0\"><table>\n<tbody>\n<thead><tr>\n<th scope=\"col\">1 </th>\n<th scope=\"col\">\n                                            To create well trained manpower for exploration and exploitation of mineral and energy resources in view of sustainable growth and development of the society\n                                        </th>\n</tr></thead>\n<tr>\n<td>2 </td>\n<td>\n                                            Developing the understanding of internal and surficial dynamics of the Earth and associated Atmospheric processes\n                                        </td>\n</tr>\n<tr>\n<td>3 </td>\n<td>\n                                            Create efficient researchers to understand and predict weather and climate\n                                        </td>\n</tr>\n<tr>\n<td>4 </td>\n<td>\n                                            To train people in order to take challenging responsibility for addressing issues relating to environment and natural hazards\n                                        </td>\n</tr>\n</tbody>\n</table></div>\n</div></details>\n<details class=\"cp-acc\"><summary>Program Educational Objectives (PEOs)</summary><div class=\"cp-acc-body\">\n<div aria-label=\"Applied Geology (M.Sc. - 2yrs)\" class=\"cp-table\" role=\"region\" tabindex=\"0\"><table>\n<tbody>\n<thead><tr>\n<th scope=\"col\">1 </th>\n<th scope=\"col\">\n                                            To impart advanced knowledge of science and technology in the fields related to Earth and Atmosphere\n                                        </th>\n</tr></thead>\n<tr>\n<td>2 </td>\n<td>\n                                            To provide a strong background on theoretical, practical and fundamental research oriented understanding\n                                        </td>\n</tr>\n<tr>\n<td>3 </td>\n<td>\n                                            To train the students with the available computational technology for addressing relevant issues\n                                        </td>\n</tr>\n<tr>\n<td>4 </td>\n<td>\n                                            To focus on the interdisciplinary, qualitative and quantitative way of teaching and research programme\n                                        </td>\n</tr>\n<tr>\n<td>5 </td>\n<td>\n                                            To create well trained scientists to address various challenges faced by industry and society\n                                        </td>\n</tr>\n<tr>\n<td>6 </td>\n<td>\n                                            Develop analytical skill to communicate effectively in verbal and documented forms\n                                        </td>\n</tr>\n</tbody>\n</table></div>\n</div></details>\n<details class=\"cp-acc\"><summary>1st Semester</summary><div class=\"cp-acc-body\">\n<div aria-label=\"Applied Geology (M.Sc. - 2yrs)\" class=\"cp-table\" role=\"region\" tabindex=\"0\"><table>\n<thead>\n<tr>\n<th scope=\"col\">Subject Code</th>\n<th scope=\"col\">Subject Name</th>\n<th scope=\"col\">L-T-P</th>\n<th scope=\"col\">Credit</th>\n<th scope=\"col\"></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>ER4111 </td>\n<td>Geochemistry </td>\n<td>3-0-0 </td>\n<td>3 </td>\n<td>\n<a href=\"/Academic/Syllabus/?id=133&amp;sid=19564\">Syllabus </a>\n</td>\n</tr>\n<tr>\n<td>ER4113 </td>\n<td>Structural Geology </td>\n<td>3-0-0 </td>\n<td>3 </td>\n<td>\n<a href=\"/Academic/Syllabus/?id=133&amp;sid=19546\">Syllabus </a>\n</td>\n</tr>\n<tr>\n<td>ER4115 </td>\n<td>Paleontology </td>\n<td>3-0-0 </td>\n<td>3 </td>\n<td>\n<a href=\"/Academic/Syllabus/?id=133&amp;sid=19547\">Syllabus </a>\n</td>\n</tr>\n<tr>\n<td>ER4161 </td>\n<td>Mineralogy Laboratory </td>\n<td>0-0-3 </td>\n<td>2 </